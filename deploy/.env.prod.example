# Domain Caddy serves and obtains a TLS certificate for (automatic HTTPS).
# A bare public hostname (e.g. app.aquarela.example) lets Caddy get and renew a
# Let's Encrypt/ZeroSSL certificate on first boot — point an A record at the
# droplet first and open ports 80/443. Use ":80" ONLY for a local TLS-less test.
CADDY_DOMAIN=app.aquarela.example

# ---------------------------------------------------------------------------
# PostgreSQL (the `postgres` compose service). Fixed user/database are declared
# in docker-compose.prod.yml; the password must match the two URLs below.
# Generate one with: openssl rand -base64 32
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Runtime/pooled connection used by web, worker and scheduler. Host is the
# compose service name `postgres` (never a public host). Never log this value.
DATABASE_URL=postgres://aquarela:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/aquarela

# Direct/session connection used by the pre-deploy migrator (advisory locks need a
# single session). Same server here; kept explicit so a future pooler cannot break
# migrations. Falls back to DATABASE_URL when unset.
DATABASE_MIGRATIONS_URL=postgres://aquarela:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/aquarela

# Runtime role that receives DML on the migrator-owned `pgboss` schema. On this
# single-role VM it is the same `aquarela` role the migrator connects as; set it
# so migrate.mjs applies the grants instead of defaulting to `app`.
PGBOSS_APP_ROLE=aquarela

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# HTTP port the Next server binds inside the container (not published; Caddy
# proxies web:3000).
PORT=3000

# Directory the local file-storage adapter writes under. docker-compose.prod.yml
# pins this to /data/uploads (the mounted uploads volume) for `web`; this value is
# documentation of that mount.
FILE_STORAGE_ROOT=/data/uploads

# ---------------------------------------------------------------------------
# Required by the web layer. `npm run bootstrap` prints the organization id; copy
# it here and restart web + scheduler afterwards (bootstrap-vm.sh does this for
# you on first run).
# ---------------------------------------------------------------------------
ORGANIZATION_ID=

# ---------------------------------------------------------------------------
# Sessions, password reset and employee invites
# ---------------------------------------------------------------------------
# Session lifetime in minutes (default 480, max 1440).
SESSION_TTL_MINUTES=480
# Password-reset token lifetime in minutes (default 30, max 1440).
PASSWORD_RESET_TTL_MINUTES=30
# Employee account-invite lifetime in minutes (default 10080 = 7 days, max 43200).
INVITE_TTL_MINUTES=10080
# Weekly maximum of shifts a linked employee may self-assign (WF-003, DEC-146).
# Integer 0-100; default 2.
SELF_ASSIGN_WEEKLY_LIMIT=2

# ---------------------------------------------------------------------------
# MFA. Base64-encoded 32-byte key that seals TOTP secrets at rest. REQUIRED for
# MFA; never reuse a key across installs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
TOTP_SECRET_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# ---------------------------------------------------------------------------
# Self-service password-reset delivery via SendGrid (DEC-147). Leave the three
# keys COMMENTED OUT to keep resets admin-issued (no email is sent). All three
# must be set to enable sending. SENDGRID_API_KEY is a secret; MAIL_FROM must be
# a verified sender; APP_BASE_URL must be the public origin (matches
# CADDY_DOMAIN + https).
#
# IMPORTANT: commenting out is not the same as blank. These keys are validated
# with a minimum length when present, so `SENDGRID_API_KEY=` (empty) is an invalid
# configuration that fails boot. Omit the line instead.
# ---------------------------------------------------------------------------
# SENDGRID_API_KEY=
# MAIL_FROM=
APP_BASE_URL=https://app.aquarela.example

# ---------------------------------------------------------------------------
# Scheduled AI advisory (ADR-0009, DEC-142). OFF by default. To enable, set
# AI_ADVISORY_ENABLED=true AND set all three LLM_* values. LLM_API_KEY is a
# secret. AI_ADVISORY_CRON default: 0 6 * * 1 (weekly, Monday 06:00). Cost limits
# are non-negative decimals at up to 4 dp; prices are per 1,000,000 tokens at up
# to 6 dp, in the same currency as the caps. With no prices set the caps are inert.
# ---------------------------------------------------------------------------
AI_ADVISORY_ENABLED=false
AI_ADVISORY_CRON=0 6 * * 1
# Commented out (not blank — blank fails validation). Set all three LLM_* to
# enable, and set the prices so the cost caps are meaningful.
# LLM_API_URL=https://api.example.ai/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=some-low-cost-model
# AI_MONTHLY_COST_LIMIT=5.0000
# AI_PER_RUN_COST_LIMIT=0.5000
# LLM_PRICE_INPUT_PER_1M=2.500000
# LLM_PRICE_OUTPUT_PER_1M=10.000000

# ---------------------------------------------------------------------------
# Scheduled competitor collection (ADR-0010, DEC-143/149). OFF by default. To
# enable set COMPETITOR_COLLECTION_ENABLED=true. robots.txt is honoured and
# requests are capped at <= 1/s per host regardless of these values.
# ---------------------------------------------------------------------------
COMPETITOR_COLLECTION_ENABLED=false
COMPETITOR_COLLECTION_CRON=0 7 * * 1
COMPETITOR_USER_AGENT=AquarelaBusinessControl/1.0 (+https://app.aquarela.example/bot)
COMPETITOR_MAX_PAGES_PER_RUN=20
COMPETITOR_MIN_DELAY_MS=1000
COMPETITOR_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Scheduler and worker knobs (ADR-0004). Read raw from process.env; every one has
# a default, so leaving them unset is safe. Do NOT set SCHEDULER_TICKS /
# WORKER_TICKS in production (they are smoke-only one-shot switches).
# ---------------------------------------------------------------------------
# SCHEDULER_INTERVAL_MS=60000
# MAINTENANCE_CRON=*/15 * * * *
# PAYROLL_CRON=0 5 * * *
# MONITOR_CRON=*/5 * * *
# WORKER_HEARTBEAT_MS=30000
# WORKER_HEARTBEAT_ID=

# ---------------------------------------------------------------------------
# First-owner bootstrap (`npm run bootstrap`, run once by bootstrap-vm.sh).
# The password is read only from BOOTSTRAP_OWNER_PASSWORD (min 12 chars) and is
# never logged or passed as a flag. By default bootstrap generates one and prints
# it once; set BOOTSTRAP_OWNER_PASSWORD to supply your own.
# ---------------------------------------------------------------------------
BOOTSTRAP_ORGANIZATION_NAME=Aquarela
BOOTSTRAP_OWNER_EMAIL=owner@aquarela.example
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_DISPLAY_NAME=Owner
# BOOTSTRAP_ROLE_CODE=owner
# BOOTSTRAP_LOCATION_ID=
# Optional. Min 12 characters. Leave the line COMMENTED OUT to have bootstrap
# generate a strong password and print it ONCE to stdout (save it immediately);
# set it to supply your own. Never passed as a flag, so it stays out of shell
# history and `ps`. A blank (`BOOTSTRAP_OWNER_PASSWORD=`) is NOT the same as
# unset: it would be supplied as an empty password and rejected.
# BOOTSTRAP_OWNER_PASSWORD=

# ---------------------------------------------------------------------------
# Optional: durable object storage (DigitalOcean Spaces) instead of the local
# uploads volume. Leave ALL of these unset to use /data/uploads. Setting some but
# not all fails closed. Ignored by this single-VM stack by default.
# ---------------------------------------------------------------------------
# SPACES_BUCKET=
# SPACES_REGION=ams3
# SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
# SPACES_ACCESS_KEY_ID=
# SPACES_SECRET_KEY=

# ---------------------------------------------------------------------------
# Optional: offsite backup copy (deploy/backup.sh). When BACKUP_S3_BUCKET is set
# AND an `aws` CLI is available, each nightly dump is uploaded to the bucket.
# Uses the standard AWS_* credential variables; keep these out of version control.
# ---------------------------------------------------------------------------
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=nightly/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ams3
# S3-compatible endpoint, e.g. https://ams3.digitaloceanspaces.com
# BACKUP_S3_ENDPOINT=
