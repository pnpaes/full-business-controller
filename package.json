{
  "name": "aquarela-business-controller",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "build": "npm run build --workspace @aquarela/web",
    "dev": "npm run dev --workspace @aquarela/web",
    "db:generate": "npm run db:generate --workspace @aquarela/persistence",
    "db:migrate": "npm run db:migrate --workspace @aquarela/persistence",
    "bootstrap": "tsx apps/web/scripts/bootstrap.ts",
    "seed:demo": "tsx apps/web/scripts/seed-demo.ts"
  },
  "overrides": {
    "postcss": "^8.5.28"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.0.0"
  }
}
