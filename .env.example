# Copy to .env (git-ignored) and adjust. Node 22 can load it with `node --env-file=.env`.
# Next.js loads .env automatically for apps/web.

# Runtime environment. One of: development | test | production.
NODE_ENV=development

# Pino level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# HTTP port used by the web app.
PORT=3000

# PostgreSQL 16 connection string (see docker-compose.yml for the local service).
# Runtime/pooled connection. Never log this value; it carries credentials.
DATABASE_URL=postgres://aquarela:aquarela@localhost:5432/aquarela

# Direct/session connection used by migrations (advisory locks must be held on a
# single session, so a transaction pooler is not safe). Falls back to
# DATABASE_URL when unset (fine locally); set it explicitly in deploy.
# DATABASE_MIGRATIONS_URL=postgres://aquarela:aquarela@localhost:5432/aquarela

# Directory the local file-storage adapter writes file bytes under (DEC-132).
# Defaults to <cwd>/storage/files, which is git-ignored. This is the local
# single-node adapter; object storage (DigitalOcean Spaces, DEC-014) is a later
# adapter behind the same port and will need its own settings.
# FILE_STORAGE_ROOT=/absolute/path/to/storage/files

# Required. The one organization this install serves (apps/web/lib/organization.ts
# throws a ConfigError without it, which fails sign-in with a 503). The auth
# commands are org-scoped, so the web layer pins the tenant rather than accepting
# one from the caller. Seeded locally by `npm run bootstrap`.
# ORGANIZATION_ID=

# Session lifetime in minutes (default 480) and password-reset token lifetime
# (default 30). Sessions are server-side; the cookie only carries the token.
# SESSION_TTL_MINUTES=480
# PASSWORD_RESET_TTL_MINUTES=30

# Base64-encoded 32-byte key that seals TOTP secrets at rest
# (packages/domain/src/auth/secret-box.ts). Required for MFA; never commit a real
# key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOTP_SECRET_ENCRYPTION_KEY=
