# Copy to .env (git-ignored) and adjust. Node 22 can load it with `node --env-file=.env`.
# Next.js loads .env automatically for apps/web.

# Runtime environment. One of: development | test | production.
NODE_ENV=development

# Pino level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# HTTP port used by the web app.
PORT=3000

# Build-time Next.js output directory (default .next). Read raw by
# apps/web/next.config.mjs; set it only for isolated verification builds (e.g.
# NEXT_DIST_DIR=.next-verify). Git-ignored.
# NEXT_DIST_DIR=.next

# PostgreSQL 16 connection string (see docker-compose.yml for the local service).
# Runtime/pooled connection. Never log this value; it carries credentials.
DATABASE_URL=postgres://aquarela:aquarela@localhost:5432/aquarela

# Direct/session connection used by migrations (advisory locks must be held on a
# single session, so a transaction pooler is not safe). Falls back to
# DATABASE_URL when unset (fine locally); set it explicitly in deploy.
# DATABASE_MIGRATIONS_URL=postgres://aquarela:aquarela@localhost:5432/aquarela

# Directory the local file-storage adapter writes file bytes under (DEC-132).
# Defaults to <cwd>/storage/files, which is git-ignored. This is the local
# single-node adapter; object storage (DigitalOcean Spaces, DEC-014) is a later
# adapter behind the same port and will need its own settings.
# FILE_STORAGE_ROOT=/absolute/path/to/storage/files

# Required. The one organization this install serves (apps/web/lib/organization.ts
# throws a ConfigError without it, which fails sign-in with a 503). The auth
# commands are org-scoped, so the web layer pins the tenant rather than accepting
# one from the caller. Seeded locally by `npm run bootstrap`.
# ORGANIZATION_ID=

# Session lifetime in minutes (default 480) and password-reset token lifetime
# (default 30). Sessions are server-side; the cookie only carries the token.
# SESSION_TTL_MINUTES=480
# PASSWORD_RESET_TTL_MINUTES=30

# Employee account-invite lifetime in minutes (default 10080 = 7 days, capped at
# 43200 = 30 days). A manager provisions an employee login and emails an invite;
# the employee sets their own password to activate the account. Set shorter in
# production if the invite window should be tighter.
# INVITE_TTL_MINUTES=10080

# Weekly maximum of shifts a linked employee may self-assign before a manager
# decides (WF-003, DEC-146). A linked employee may request only their own shifts
# at their primary location and matching role; each request opens as
# `pending_approval` and a manager approves or rejects it. The cap counts the
# employee's self-originated assignments (pending, self-assigned or approved)
# that overlap the shift's UTC week (Monday 00:00 UTC → Monday). Default 2;
# accepts an integer 0–100 (0 blocks self-assignment entirely).
# SELF_ASSIGN_WEEKLY_LIMIT=2

# Base64-encoded 32-byte key that seals TOTP secrets at rest
# (packages/domain/src/auth/secret-box.ts). Required for MFA; never commit a real
# key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOTP_SECRET_ENCRYPTION_KEY=

# Self-service password-reset delivery via SendGrid (DEC-147). All three are needed
# before the adapter sends; with any missing, the reset token is still minted and
# stored but nothing is emailed (the reset stays admin-issued). SENDGRID_API_KEY is
# a secret supplied at deploy (App Platform SECRET); MAIL_FROM must be a verified
# SendGrid sender; APP_BASE_URL is the public origin used to build the (token-free)
# reset link. All three must be set to enable sending.
# SENDGRID_API_KEY=
# MAIL_FROM="Aquarela <no-reply@example.no>"
# APP_BASE_URL=https://app.example.no

# Scheduled AI advisory (ADR-0009, DEC-142). Advisory only: suggestions are never
# applied automatically. OFF by default — set AI_ADVISORY_ENABLED=true to enable
# (accepts "true" case-insensitively; anything else, including unset, keeps it
# off). LLM_API_URL is an OpenAI-compatible chat-completions endpoint; all three
# LLM_* values must be set or the adapter fails closed and makes no request.
# LLM_API_KEY is a secret supplied at deploy (App Platform SECRET); never commit
# a real key. AI_ADVISORY_CRON defaults to "0 6 * * 1" (weekly, Monday 06:00).
# AI_MONTHLY_COST_LIMIT / AI_PER_RUN_COST_LIMIT are non-negative decimal strings
# at up to 4 dp (e.g. "5.0000"), matching the recorded cost scale; the scheduled
# run skips (no LLM call) once the month-to-date recorded cost reaches the
# monthly cap. A malformed limit fails the scheduler at boot.
#
# LLM_PRICE_INPUT_PER_1M / LLM_PRICE_OUTPUT_PER_1M price the completion so the
# caps can see a real cost: non-negative decimal strings at up to 6 dp (e.g.
# "2.500000" = 2.50 per 1,000,000 tokens), in whatever currency the caps are
# expressed in. No vendor price is hardcoded — set these from your provider's
# price sheet and keep them current. Both unset ⇒ the adapter records no cost
# (costEstimate null) and the caps stay inert; one set ⇒ only that side's tokens
# are priced. Checked at scheduler boot: a malformed price fails the boot.
# AI_ADVISORY_ENABLED=false
# AI_ADVISORY_CRON=0 6 * * 1
# LLM_API_URL=https://api.example.ai/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=some-low-cost-model
# AI_MONTHLY_COST_LIMIT=5.0000
# AI_PER_RUN_COST_LIMIT=0.5000
# LLM_PRICE_INPUT_PER_1M=2.500000
# LLM_PRICE_OUTPUT_PER_1M=10.000000

# Scheduled competitor collection (ADR-0010, DEC-143/DEC-149). OFF by default —
# set COMPETITOR_COLLECTION_ENABLED=true to enable (accepts "true"/"1"/"yes"
# case-insensitively; anything else, including unset, keeps it off). The cron is
# always registered; the kill switch is evaluated per run, so one env flip
# enables it without a redeploy. Collection is restricted to sources that are
# active AND collection_mode='automated' AND terms_status='approved'; robots.txt
# is honoured (fail closed when it cannot be fetched or parsed), requests are
# rate-limited to at most one per second per host, each run has a bounded page
# budget, and 429/5xx responses are retried with backoff. Captured facts open as
# `pending` observations for human review; nothing is auto-published or applied.
# COMPETITOR_COLLECTION_ENABLED=false
# COMPETITOR_COLLECTION_CRON=0 7 * * 1
# COMPETITOR_USER_AGENT="AquarelaBusinessControl/1.0 (+https://aquarela.example/bot)"
# COMPETITOR_MAX_PAGES_PER_RUN=20
# COMPETITOR_MIN_DELAY_MS=1000
# COMPETITOR_TIMEOUT_MS=10000

# Scheduler and worker knobs (ADR-0004). Read raw from process.env by
# apps/scheduler and apps/worker (not the env.ts schema); every one has a
# default, so leaving them unset is safe. Documented here so the raw-read
# surface does not drift from the deploy configuration.
# SCHEDULER_INTERVAL_MS=60000
# SCHEDULER_TICKS=1
# MAINTENANCE_CRON=*/15 * * * *
# PAYROLL_CRON=0 5 * * *
# MONITOR_CRON=*/5 * * * *
# WORKER_HEARTBEAT_MS=30000
# WORKER_TICKS=1
# WORKER_HEARTBEAT_ID=

# Pre-deploy migration job: the runtime role granted DML on the migrator-owned
# `pgboss` schema (default `app`; a no-op locally where the role does not exist).
# PGBOSS_APP_ROLE=app

# First-owner bootstrap CLI (`npm run bootstrap`, run once at first deploy). The
# password is read only from the environment, never a CLI flag, so it stays out
# of shell history; see the deployment runbook.
# BOOTSTRAP_ORGANIZATION_NAME=
# BOOTSTRAP_OWNER_EMAIL=
# BOOTSTRAP_OWNER_USERNAME=
# BOOTSTRAP_OWNER_DISPLAY_NAME=
# BOOTSTRAP_ROLE_CODE=owner
# BOOTSTRAP_LOCATION_ID=
# BOOTSTRAP_OWNER_PASSWORD=
