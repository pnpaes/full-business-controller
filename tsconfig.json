{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@aquarela/application": ["./packages/application/src/index.ts"],
      "@aquarela/config": ["./packages/config/src/index.ts"],
      "@aquarela/domain": ["./packages/domain/src/index.ts"],
      "@aquarela/jobs-runtime": ["./packages/jobs-runtime/src/index.ts"],
      "@aquarela/logger": ["./packages/logger/src/index.ts"],
      "@aquarela/persistence": ["./packages/persistence/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/worker/**/*.ts",
    "apps/scheduler/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next", "**/coverage", "packages/ui"]
}
